doctype html
html(lang="en")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width,initial-scale=1")
        meta(name="color-scheme" content="light dark")
        title peña.dev
        link(href="/style.css" rel="stylesheet" type="text/css")
        script(src="/dots.js" defer)

    body
        main.home
            section.art(aria-hidden="true")
                canvas#dots

            div.copy
                div.copy-body
                    h1.reveal(style="--d: 0ms") peña.dev
                    p.reveal(style="--d: 450ms") Time is the fire in which we burn.

                    section.links.reveal(style="--d: 650ms" aria-labelledby="links-label")
                        h2.label#links-label Elsewhere
                        ul
                            li
                                a(href="https://github.com/johnpena")
                                    span.title GitHub
                                    span.meta code
                            li
                                a(href="https://www.linkedin.com/in/john-pe%C3%B1a-1122646/")
                                    span.title LinkedIn
                                    span.meta work
                            li
                                a(href="https://twitter.com/pena")
                                    span.title Twitter
                                    span.meta posts

                footer.reveal(style="--d: 850ms") © 2026 John Peña
